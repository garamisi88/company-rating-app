{% if pageCount > 1 %}
    <nav class="mt-4" aria-label="{{ 'pagination.label'|trans }}">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item{{ currentPage <= 1 ? ' disabled' }}">
                <a class="page-link" rel="prev"
                   href="{{ path(routeName, routeParams|merge({ page: currentPage - 1 })) }}">
                    <span aria-hidden="true">‹</span>
                    <span class="visually-hidden">{{ 'pagination.previous'|trans }}</span>
                </a>
            </li>

            {% for page in 1..pageCount %}
                <li class="page-item{{ page == currentPage ? ' active' }}">
                    {% if page == currentPage %}
                        <span class="page-link" aria-current="page">{{ page }}</span>
                    {% else %}
                        <a class="page-link"
                           href="{{ path(routeName, routeParams|merge({ page: page })) }}">{{ page }}</a>
                    {% endif %}
                </li>
            {% endfor %}

            <li class="page-item{{ currentPage >= pageCount ? ' disabled' }}">
                <a class="page-link" rel="next"
                   href="{{ path(routeName, routeParams|merge({ page: currentPage + 1 })) }}">
                    <span aria-hidden="true">›</span>
                    <span class="visually-hidden">{{ 'pagination.next'|trans }}</span>
                </a>
            </li>
        </ul>
    </nav>
{% endif %}
