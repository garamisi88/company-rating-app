{% extends 'base.html.twig' %}

{% block title %}{{ 'review.index.title'|trans }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">{{ 'review.index.title'|trans }}</h1>

    {% if reviews is empty %}
        <p class="text-body-secondary">{{ 'review.index.empty_list'|trans }}</p>
    {% else %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        {% for review in reviews %}
            {{ include('components/review_card.html.twig', {
                review: review
            }) }}
        {% endfor %}
        </div>
    {% endif %}
{% endblock %}
