{% extends 'base.html.twig' %}

{% block title %}{{ 'review.index.title'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-5">
        <h1 class="h3 mb-4">{{ 'review.index.title'|trans }}</h1>
        <div class="dropdown">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
                {{ sort.translationKey|trans }}
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                {% for option in sortOptions %}
                    <li>
                        <a class="dropdown-item{{ option.value == sort.value ? ' active' }}"
                           href="{{ path('app_review_index', { sort: option.value }) }}">
                            {{ option.translationKey|trans }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>

    {% if reviews is empty %}
        <p class="text-body-secondary">{{ 'review.index.empty_list'|trans }}</p>
    {% else %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        {% for review in reviews %}
            <div class="col">
                {{ include('components/review_card.html.twig', {
                    review: review
                }) }}
            </div>
        {% endfor %}
        </div>
        {{ include('components/pagination.html.twig', {
            currentPage: currentPage,
            pageCount: pageCount,
            routeName: 'app_review_index',
            routeParams: { sort: sort.value },
        }) }}
    {% endif %}
{% endblock %}
