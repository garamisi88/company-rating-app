<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}{{ 'app.name'|trans }}!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⭐</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
            <link rel="stylesheet" href="{{ asset('assets/css/app.css') }}" />
        {% endblock %}
    </head>
    <body class="bg-body-tertiary">
        <nav class="navbar navbar-expand-lg bg-white border-bottom mb-4">
            <div class="container">
                <a class="nav-link" href="{{ path('app_review_index') }}">
                    Vélemények
                </a>
                <a class="nav-link ms-3" href="{{ path('app_company_index') }}">
                    {{ 'nav.companies'|trans }}
                </a>
                <a class="btn btn-primary btn-sm ms-auto" href="{{ path('app_review_new') }}">
                    {{ 'nav.new_review'|trans }}
                </a>
            </div>
        </nav>

        <main class="container pb-5">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                        {{ message|trans }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'action.close'|trans }}"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% endblock %}
    </body>
</html>
